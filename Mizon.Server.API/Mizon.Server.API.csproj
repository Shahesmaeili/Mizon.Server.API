<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishAot>false</PublishAot>
	  <IsAotCompatible>true</IsAotCompatible>
	  <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
	  <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
	  <StripSymbols>true</StripSymbols>
	  <TrimMode>full</TrimMode>
	  <PublishTrimmed>true</PublishTrimmed>
	  <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
	  <Platforms>AnyCPU;x64</Platforms>
    <CustomAfterStaticWebAssetsSdkTargets Condition="'$(NETCoreSdkVersion)' == '11.0.100'">$(MSBuildProjectDirectory)/Build/Sdk11StaticWebAssets.targets</CustomAfterStaticWebAssetsSdkTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mizon.Server.Logic\Mizon.Server.Logic.csproj" />
    <ProjectReference Include="..\Mizon.Server\Mizon.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="App_Data\MoodEmojis\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="App_Data\MoodEmojis\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Expanded JSON remains an authoring/verification artifact; clients fetch
         the original TGS and expand only the selected animation. -->
    <Content Update="App_Data\MoodEmojis\animations\**\*;App_Data\MoodEmojis\effects\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="App_Data\MoodEmojis\animations\**\*;App_Data\MoodEmojis\effects\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  
</Project>
