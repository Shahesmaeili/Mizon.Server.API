<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup Condition="'$(BaselineLogicDirectory)' == ''">
    <ProjectReference Include="..\..\Mizon.Server.Logic\Mizon.Server.Logic.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BaselineLogicDirectory)' != ''">
    <Reference Include="Mizon.Server.Logic">
      <HintPath>$(BaselineLogicDirectory)\Mizon.Server.Logic.dll</HintPath>
    </Reference>
    <Reference Include="Mizon.Server"><HintPath>$(BaselineLogicDirectory)\Mizon.Server.dll</HintPath></Reference>
    <Reference Include="Mizon.Database"><HintPath>$(BaselineLogicDirectory)\Mizon.Database.dll</HintPath></Reference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
  </ItemGroup>
</Project>
